<%#
  Full post view, containing all details and interactions.
  Variables:
    post : the Post instance to display
    float_notice : whether to display the float notice
%>

<% float_notice ||= false %>
<% category ||= defined?(@category) && @category.id == post.category_id ? @category : post.category %>
<% post_type ||= defined?(@post_type) && @post_type.id == post.post_type_id ? @post_type : post.post_type %>

<% is_question = post.post_type_id == Question.post_type_id %>
<% is_top_level = post.parent_id.nil? %>
<% title = post.title ?
  post.title + (post.closed && !post.duplicate_post ? " [closed]" : "") \
             + (post.duplicate_post ? " [duplicate]" : "")
  : ''
%>
<% user = post.user %>

<% comment_threads = post.comment_threads.initially_visible.order(updated_at: :desc) %>
<% comment_thread = comment_threads.first %>
<% public_count = comment_threads.count %>
<% available_count = current_user&.has_post_privilege?('flag_curate', post) ?
  post.comment_threads.count :
  post.comment_threads.publicly_available.count %>


<!-- =============== START MOCHI ======================== -->

<!-- post--votes class needed by votes.js -->
<div id="post-<%= post.id %>" class="post" data-post-id="<%= post.id %>">
  <% unless title.blank? %>
    <h1 class="title">
      <span class="post--title-text"><%= title %></span>
    </h1>
    <div class="post-byline">
      <strong><%= user_link post.user %></strong>
      posted in
      <span class="sign-up-to-post category-tag" style="font-weight: 500; color: var(--color-fg); fill: var(--color-fg-subtle); display: inline-flex; align-items: center; gap: 3px;">
        <%= octicon "hash", :height => 12,  :class => "category-icon", :"aria-label" => category.name %>
        <%= category.name %>
      </span>
    </div>
  <% end %>
  <div class="post-container">
    <div class="post-header">
      <div style="display: flex; align-items: center; gap: 8px;">
        <%= render 'mochi/posts/user_byline', user: user, post: post %>
      </div>

      <button class="mochi--toggle-drop-down" data-drop-down-id="post-actions-<%= post.id %>"
        style="position: relative;">
        <%= octicon 'kebab-horizontal', :height => 16, :"aria-label" => "Actions" %>
        <div class="post--actions mochi--drop-down-menu" data-drop-down-id="post-actions-<%= post.id %>">
          <ul>
            <li>
              <%= link_to generic_share_link(post), class: 'tools--item js-permalink' do %>
                <i class="fa fa-link"></i>
                <span class="js-text">Permalink</span>
              <% end %>
            </li>
            <li>
              <%= link_to post_history_path(post), class: 'tools--item' do %>
                <i class="fa fa-history"></i>
                History
              <% end %>
            </li>
            <% if (post_type.is_public_editable && !post.locked?) || current_user&.is_moderator || post.user == current_user %>
              <% if check_your_post_privilege(post, 'edit_posts') %>
                <% if post.pending_suggested_edit? %>
                  <li>
                    <%= link_to suggested_edit_url(post.pending_suggested_edit.id), class: 'tools--item is-danger is-filled' do %>
                      <i class="fa fa-spell-check"></i>
                      Review suggested edit
                    <% end %>
                  </li>
                <% else %>
                  <li>
                    <%= link_to edit_post_path(post), class: 'tools--item' do %>
                      <i class="fa fa-pencil-alt"></i>
                      Edit
                    <% end %>
                  </li>
                <% end %>
              <% elsif !current_user.nil? %>
                <% if post.pending_suggested_edit? %>
                  <li>
                    <span class="tools--item">suggested edit pending...</span>
                  </li>
                <% else %>
                  <li>
                    <%= link_to edit_post_path(post), class: 'tools--item' do %>
                      <i class="fa fa-pencil-alt"></i>
                      Suggest edit
                    <% end %>
                  </li>
                <% end %>
              <% end %>
            <% end %>
            <% if user_signed_in? %>
              <li>
                <a href="#" class="flag-dialog-link tools--item">
                  <i class="fa fa-flag"></i>
                  Flag
                </a>
              </li>
            <% end %>
            <% unless post.locked? || !post_type.is_closeable %>
              <% if check_your_privilege('flag_close') || (post.user_id === current_user&.id)%>
                <% if !post.closed %>
                  <li>
                    <a href="#" class="close-dialog-link tools--item">
                      <i class="fa fa-lock"></i>
                      Close
                    </a>
                  </li>
                <% elsif post.closed %>
                  <li>
                    <%= link_to reopen_post_path(post), method: :post, class: 'reopen-question tools--item' do %>
                      <i class="fa fa-unlock"></i>
                      Reopen
                    <% end %>
                  </li>
                <% end %>
              <% end %>
            <% end %>
            <% if check_your_post_privilege(post, 'flag_curate') %>
              <% unless post.locked? %>
                <% if !post.deleted %>
                  <li>
                    <%= link_to delete_post_path(post), method: :post,
                                data: { confirm: 'Are you sure you want to delete this post?' }, class: "tools--item is-danger" do %>
                      <i class="fa fa-trash"></i>
                      Delete
                    <% end %>
                  </li>
                <% else %>
                  <li>
                    <%= link_to restore_post_path(post), method: :post,
                                data: { confirm: 'Restore this post, making it visible to regular users?' }, class: "tools--item is-danger is-filled" do %>
                      <i class="fa fa-undo"></i>
                      Restore
                    <% end %>
                  </li>
                <% end %>
              <% end %>
            <% end %>
            <% if check_your_privilege('flag_curate') %>
              <li>
                <a href="javascript:void(0);" data-modal="#mod-tools-<%= post.id %>" class="tools--item">
                  <i class="fa fa-wrench"></i>
                  Tools
                </a>
              </li>
              <% flags_count = if current_user&.is_moderator
                                 post.flags
                               else
                                 post.flags.not_confidential
                               end.where(handled_by_id: nil).count %>

              <% own_flags_count = if current_user&.is_moderator
                                     0
                                   else
                                     post.flags.not_confidential.where(user: current_user, handled_by_id: nil).count
                                   end %>

              <% if flags_count > 0 %>
                <li>
                  <a href="#" class="show-all-flags-dialog-link tools--item">
                    <i class="fa fa-exclamation-triangle"></i>
                    Show <%= pluralize(flags_count - own_flags_count, 'flag') %>
                  </a>
                </li>
              <% end %>
            <% end %>
          </ul>
        </div>
      </button>
    </div>

    <div class="post-body">
      <%= raw(sanitize(post.body, scrubber: scrubber)) %>
    </div>

    <!-- post--votes class needed by votes.js -->
    <div class="post-footer">
      <div class="post--votes">
        <% if post_type.has_votes %>
          <% existing_vote = my_vote(post) %>
          <button class="vote-button button is-icon-only-button <%= (existing_vote&.vote_type == 1) ? 'is-active' : '' %>"
                  data-vote-type="1" data-post-id="<%= post.id %>"
                  data-vote-id="<%= existing_vote&.id %>"
                  id="post-<%= post.id %>-up" aria-label="Upvote">
            <%= octicon 'arrow-up', :height => 16,  :class => "upvote-icon", :"aria-label" => "Upvote" %>
            <span class="js-upvote-count"><%= post.upvote_count %></span>
          </button>

          <div class="vote-holder" style="display: none;">
            <% existing_vote = my_vote(post) %>
            <% unless post.locked? %>
              <button class="vote-button button is-icon-only-button <%= (existing_vote&.vote_type == 1) ? 'is-active' : '' %>"
                      data-vote-type="1" data-post-id="<%= post.id %>" data-vote-id="<%= existing_vote&.id %>" id="post-<%= post.id %>-up" aria-label="Upvote">
                
                <%= octicon 'arrow-up', :height => 16,  :class => "upvote-icon", :"aria-label" => "All posts" %>
              </button>
            <% end %>
            <span class="js-upvote-count"><%= post.upvote_count %></span>
          </div>

          <% if user_signed_in? && post.post_type.has_reactions && post.post_type.reactions.any? %>
            <div class="post--react has-text-align-center">
              <% unless post.locked? %>
                <button class="react-button button is-muted is-icon-only-button h-fw-bold"
                        id="post-<%= post.id %>-react" aria-label="Add Reaction"
                        data-drop="#post-<%= post.id %>-reactions-panel"
                        data-drop-self-class-toggle="is-active"
                        data-drop-force-dir="down">
                    react
                </button>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
      <span class="comment-count">
        <%= pluralize(comment_thread&.reply_count, 'comment') %>
      </span>
    </div>
    <% if comment_thread %>
      <div class="post-comments">
        <%= render 'mochi/comments/thread', comment_thread: comment_thread %>
      </div>
    <% else %>
      <%= render 'mochi/comments/new_thread_modal', post: post %>
    <% end %>
  </div>
</div>


<!-- =============== END MOCHI ======================== -->

<% if false && (moderator? || current_user&.has_post_privilege?('flag_curate', post)) %>
  <%= render 'posts/post_tools', post: post %>
<% end %>

<% if false && post.post_type.has_reactions && !post.locked? && user_signed_in? %>
  <%= render 'reactions/dialog', post: post %>
<% end %>

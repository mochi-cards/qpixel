<% category ||= defined?(@category) && @category.id == @post.category_id ? @category : @post.category %>
<% post_type ||= defined?(@post_type) && @post_type.id == post.post_type_id ? @post_type : @post.post_type %>
<% user = @post.user %>

<div style="display: grid; grid-template-columns: 200px 1fr;">

  <%= render 'mochi/categories/list' %>

  <div style="padding: 0 32px;">

    <h1 style="font-weight: 500; margin: 0 0 16px 0;">
      <%= @post.title %>
    </h1>

    <% if false %>
    <%= render 'mochi/posts/user_byline', user: user, post: @post %>
    <% end %>

    <%= render 'mochi/posts/body', post: @post, main_post: @post %>

    <% if @post.post_type.has_answers %>

      <!-- Sorting -->
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <div>
          <h3 style="font-size: 16px; margin: 0;"><%= pluralize(@post.children.where(deleted: false).count, @post.post_type.answer_type.name) %></h2>
        </div>
        <div class="pills-container">
          <div class="pill-button">
            <%= link_to 'Oldest', request.params.merge(sort: 'age', direction: 'asc'),
                class: "button is-muted is-outlined #{params[:sort].nil? || params[:sort] == 'age' ? 'active' : ''}",
                title: 'Oldest posts first (ignores other activity)' %>
          </div>
          <div class="pill-button">
            <%= link_to 'Activity', request.params.merge(sort: 'active', direction: 'desc'),
                class: "button is-muted is-outlined #{params[:sort] == 'active' ? 'active' : ''}",
                title: 'most recent changes first: new answers, edits, delete/undelete' %>
          </div>
          <% if @post.post_type.has_votes %>
            <div class="pill-button">
              <a href="<%= query_url(sort: 'score', direction: 'desc') %>" class="<%= params[:sort] == 'score' ? 'active' : '' %>">Score</a>
            </div>
          <% end %>
        </div>
      </div>

      <div class="post-separator"></div>

      <!-- Child posts -->
      <% @children.each do |answer| %>
        <%= render 'mochi/posts/body', post: answer, main_post: @post, children: @children %>
      <% end %>

      <!-- Reply form -->
      <% if user_signed_in? && !@post.closed %>
        <%= render 'mochi/posts/form',
          post: Post.new(
            post_type_id: Answer.post_type_id,
            category: @post.category,
            parent: @post
          ),
          type_summary: false,
          category: @post.category,
          post_type: PostType['Answer'],
          inline_parent: false,
          submit_path: create_response_path(post_type: PostType['Answer'], parent: @post)
        %>
      <% elsif !@post.closed %>
        <div class="sign-up-to-post">
          <%= link_to 'Sign up', new_saml_user_session_path, class: 'mochi-button button', style: "margin-right: 6px;" %>
          to post a reply. Already have an account? <%= link_to 'Log in', new_saml_user_session_path, class: '' %> to comment.
        </div>
      <% end %>
    <% end %>
  </div>
</div>


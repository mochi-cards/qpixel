<% category ||= defined?(@category) && @category.id == @post.category_id ? @category : @post.category %>
<% post_type ||= defined?(@post_type) && @post_type.id == post.post_type_id ? @post_type : @post.post_type %>
<% user = @post.user %>

<% content_for :title, @post.title.truncate(max_title_length(@post.category)) %>
<% content_for :description do %>
  <% Rails.cache.fetch "posts/#{@post.id}/description" do %>
    <%= @post.body_plain[0..74].strip %>...
    <%= @post.children.any? ? @post.children.first.body_plain[0..74].strip : '' %>
  <% end %>
<% end %>

<% content_for :twitter_card_meta do %>
  <meta name="twitter:card" content="summary" />
  <% if @post.user&.twitter&.present? %>
    <meta name="twitter:creator" content="@<%= @post.user.twitter %>" />
  <% end %>
  <meta property="og:url" content="<%= post_url(@post) %>" />
  <meta property="og:title" content="<%= @post.title %>" />
  <meta property="og:description" content="<%= @post.body_plain[0..150].strip %>..." />
  <meta property="og:image" content="<%= "https://#{RequestContext.community.host}#{SiteSetting['SiteLogoPath']}" %>" />
<% end %>

<div style="display: grid; grid-template-columns: 200px 1fr;">

  <%= render 'mochi/categories/list' %>

  <div style="padding: 0 32px; max-width: 50em">

    <h1 class="post-show--title">
      <% if @post.post_type.is_closeable && @post.closed && !@post.duplicate_post %>
        <%= octicon 'lock', :height => 24,  :class => "post-title-icon", :"aria-label" => "Unmark as answer" %>
      <% end %>
      <%= @post.title %>
    </h1>

    <%= render 'mochi/posts/body', post: @post, main_post: @post, post_type: post_type %>

    <% if @post.post_type.has_answers %>

      <!-- Sorting -->
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <div>
          <h3 style="font-size: 16px; margin: 0;"><%= pluralize(@post.children.where(deleted: false).count, @post.post_type.answer_type.name) %></h2>
        </div>
        <% sort_param = params[:sort] || @post.post_type.has_votes ? 'score' : 'age' %>
        <div class="pills-container">
          <div class="pill-button">
            <%= link_to 'Oldest', request.params.merge(sort: 'age', direction: 'asc'),
                class: "button is-muted is-outlined #{sort_param == 'age' ? 'active' : ''}",
                title: 'Oldest posts first (ignores other activity)' %>
          </div>
          <div class="pill-button">
            <%= link_to 'Activity', request.params.merge(sort: 'active', direction: 'desc'),
                class: "button is-muted is-outlined #{sort_param == 'active' ? 'active' : ''}",
                title: 'most recent changes first: new answers, edits, delete/undelete' %>
          </div>
          <% if @post.post_type.has_votes %>
            <div class="pill-button">
              <a href="<%= query_url(sort: 'score', direction: 'desc') %>" class="<%= sort_param == 'score' ? 'active' : '' %>">Most Voted</a>
            </div>
          <% end %>
        </div>
      </div>

      <div class="post-separator"></div>

      <!-- Child posts -->
      <% @children.each do |answer| %>
        <%= render 'mochi/posts/body', post: answer, main_post: @post, children: @children %>
      <% end %>

      <!-- Reply form -->
      <% if user_signed_in? && !@post.closed %>
        <%= render 'mochi/posts/form',
          post: Post.new(
            post_type_id: Answer.post_type_id,
            category: @post.category,
            parent: @post
          ),
          type_summary: false,
          category: @post.category,
          post_type: PostType['Answer'],
          inline_parent: false,
          submit_path: create_response_path(post_type: PostType['Answer'], parent: @post)
        %>
      <% elsif !@post.closed %>
        <div class="sign-up-to-post">
          <span>
          <%= link_to 'Sign up', new_saml_user_session_path, class: 'mochi-button button', style: "margin-right: 6px;" %>
          to post a reply. Already have an account? <%= link_to 'Log in', new_saml_user_session_path, class: '' %> to comment.
          </span>
        </div>
      <% elsif @post.closed %>
        <div class="sign-up-to-post">
          <%= octicon 'lock', :height => 20,  :class => "upvote-icon", :"aria-label" => "Unmark as answer" %>
          This post has been closed.
        </div>
      <% end %>
    <% end %>
  </div>
</div>


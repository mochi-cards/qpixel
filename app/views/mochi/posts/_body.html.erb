<% user = post.user %>
<% is_question = post.post_type_id == Question.post_type_id %>

<div id="<%= (is_question ? 'question-' : 'answer-') + post.id.to_s %>" class="<%= post.deleted? ? 'deleted' : '' %>">
  <div style="display: flex; justify-content: space-between;">
    <div class="post-byline">
      <img alt="user card" src="<%= avatar_url(user, 32) %>" class="avatar" />
      <strong style="color: var(--color-fg);"><%= user_name post.user %></strong>
      <% if user.is_admin %>
        <span class="user-label">Admin</span>
      <% elsif user.is_moderator %>
        <span class="user-label">Mod</span>
      <% end %>
      <% if user.staff? %>
        <span class="user-label">Staff</span>
      <% end %>
      <%= link_to generic_share_link(post) do %>
        <%= time_ago_in_words(post.created_at) %> ago
      <% end %>
      <% if user == current_user %>
        <div>
          &nbsp;&middot;&nbsp;
          <%= link_to edit_post_path(post), class: '' do %>
            Edit post
          <% end %>
        </div>
      <% end %>
      <% if post.deleted? %>
        <span class="deleted-label">Deleted</span>
      <% end %>
    </div>
  </div>

  <div class="post-body">
    <%= render_pings_in_post(raw(sanitize(post.body, scrubber: scrubber)), pingable: get_pingable_for_post(post)) %>
  </div>

  <!-- Cannot have whitespace with :empty selector -->
  <div class="post-footer"><%= render 'mochi/posts/votes', post: post %><%= render 'mochi/posts/reactions', post: post, main_post: post %><%= render 'mochi/posts/tools', post: post %><%= render 'mochi/posts/tags', post: post %></div>

  <% if @post.post_type.has_comments %>
    <%= render 'mochi/comments/thread', post: post, main_post: post %>
  <% end %>
</div>

<div class="post-separator"></div>

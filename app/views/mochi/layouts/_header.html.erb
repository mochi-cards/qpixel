<header id="top-bar">
  <a href="https://mochi.cards/">
    <%= image_tag asset_path('mochi/icon.webp'), height: 40, width: 40 %>
    <span>Mochi</span>
  </a>
  <div class="links lg">
    <a href="https://mochi.cards/blog">
      Blog
    </a>
    <a href="https://mochi.cards/changelog.html">
      What's new?
    </a>
    <a href="https://mochi.cards/docs/">
      Docs
    </a>
    <a href="https://mochi.cards/#pricing-section">
      Pricing
    </a>
    <% if user_signed_in? %>
      <%= link_to 'Log out', destroy_saml_user_session_path, method: :delete, class: '' %>
    <% else %>
      <%= link_to 'Log in', new_saml_user_session_path, class: '' %>
    <% end %>
  </div>
</header>

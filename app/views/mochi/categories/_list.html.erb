<div class="category-sidebar">

  <ul class="category-list">

    <!-- Category list -->
    <li>
      <%= link_to root_path, class: "category-link #{current_page?(root_url) ? 'active' : ''}" do %>
        <div>
          <%= octicon 'comment-discussion', :height => 16,  :class => "category-icon", :"aria-label" => "All posts" %>
          All posts
        </div>
      <% end %>
    </li>

    <% @header_categories.each do |cat| %>
      <% next unless (current_user&.trust_level || 0) >= (cat.min_view_trust_level || -1) %>
      <li>
        <%= link_to category_path(cat), class: "category-link #{active?(cat) ? 'active' : ''}" do %>
          <div>
            <% icon_name = "hash" %>
            <% if icon_name %>
              <%= octicon icon_name, :height => 16,  :class => "category-icon", :"aria-label" => cat.name %>
            <% end %>
            <%= cat.name %>
          </div>
          <% if user_signed_in? && cat.new_posts_for?(current_user) %>
            <span class="badge is-status" title="unread activity in category"></span>
          <% end %>
        <% end %>
      </li>
    <% end %>

    <!-- Subscribe button -->
    <% if false %>
      <li style="display: none;">
        <%= link_to 'Subscribe',
                    new_subscription_path(type: 'category', qualifier: @category.id, return_to: request.path),
                    class: 'button is-outlined' %>
      </li>
    <% end %>
  </ul>

  <% if current_user %>
    <hr class="category-list" style="margin: 15px 15px 15px 0; border-top: 1px solid var(--border-color)">

    <ul class="category-list">
      <li>
        <%= link_to edit_user_profile_path, class: "category-link #{current_page?(edit_user_profile_url) ? 'active' : ''}" do %>
          <div>
            <%= octicon 'person', :height => 16,  :class => "category-icon", :"aria-label" => "Inbox" %>
            Profile
          </div>
        <% end %>
      </li>
      <li>
        <%= link_to notifications_path, class: "category-link #{current_page?(notifications_url) ? 'active' : ''}" do %>
          <div>
            <%= octicon 'inbox', :height => 16,  :class => "category-icon", :"aria-label" => "Inbox" %>
            Inbox
            <% unread = current_user.unread_count %>
          </div>
          <% if unread > 0 %>
            <div class="inbox-count"><%= unread %></div>
          <% end %>
        <% end %>
      </li>
    </ul>
  <% end %>
</div>

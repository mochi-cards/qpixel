<% content_for :title, @category.name %>
<%
  icon_names = {
    'Talk'     => 'comment-discussion',
    'Help'     => 'question',
    'Feedback' => 'diff-added'
  }
%>

<div style="display: grid; grid-template-columns: 256px 1fr;">
  <div class="category-sidebar">
    <ul class="category-list">
      <h2 style="font-size: 16px;">Categories</h2>
      <li>
        <%= link_to posts_path, class: "category-link" do %>
          <%= octicon 'comment-discussion', :height => 16,  :class => "category-icon", :"aria-label" => "All posts" %>

          All posts
        <% end %>
      </li>
      <% @header_categories.each do |cat| %>
        <% next unless (current_user&.trust_level || 0) >= (cat.min_view_trust_level || -1) %>
        <li>
          <%= link_to category_path(cat), class: "category-link #{active?(cat) ? 'active' : ''}" do %>
            <% icon_name = "hash" %>
            <% if icon_name %>
              <%= octicon icon_name, :height => 16,  :class => "category-icon", :"aria-label" => cat.name %>
            <% end %>
            <%= cat.name %>
            <% if user_signed_in? && cat.new_posts_for?(current_user) %>
              <span class="badge is-status" title="unread activity in category"></span>
            <% end %>
          <% end %>
        </li>
      <% end %>

      <% if current_user&.is_admin %>
        <li>
          <%= link_to 'Edit Category', edit_category_path(@category) %>
        </li>
      <% end %>

      <li style="display: none;">
        <%= link_to 'Subscribe',
                    new_subscription_path(type: 'category', qualifier: @category.id, return_to: request.path),
                    class: 'button is-outlined' %>
      </li>
    </ul>
  </div>

  <div>
    <h2 class="category-title">
      <% icon_name = icon_names[@category.name] %>
      <% if icon_name %>
        <%= octicon 'hash', :height       => 20,
                            :class        => "category-icon",
                            :"aria-label" => @category.name %>
      <% end %>
      <%= @category.name %>
    </h2>

    <% if @category.short_wiki %>
      <div class="category-description" data-category-id="<%= @category.id %>">
        <% cache [@category, 'description-rendered'] do %>
          <%= raw(sanitize(render_markdown(@category.short_wiki), scrubber: scrubber)) %>
        <% end %>
      </div>
    <% end %>

    <% post_count = @posts.count %>

    <div class="category-toolbar">
      <div class="pills-container">
        <div class="pill-button">
          <%= link_to 'Trending', query_url(sort: 'activity'),
                      class: "#{(params[:sort].nil?) && !current_page?(questions_lottery_path) || params[:sort] == 'activity' ? 'active' : ''}",
                      title: 'most recent changes: new posts, edits, close/open, delete/undelete' %>
        </div>
        <div class="pill-button">
          <%= link_to 'Recent', query_url(sort: 'age'),
                      class: "#{params[:sort] == 'age' ? 'active' : ''}",
                      title: 'newest posts (ignores other activity)' %>
        </div>
        <div class="pill-button">
          <%= link_to 'Most Voted', query_url(sort: 'score'),
                      class: "#{params[:sort] == 'score' ? 'active' : ''}",
                      title: 'highest score first (not the same as net votes)' %>
        </div>
        <% if SiteSetting['AllowContentTransfer'] %>
          <div class="pill-button">
            <%= link_to 'Native', query_url(sort: 'native'),
                        class: "#{params[:sort] == 'native' ? 'active' : ''}",
                        title: 'exclude imported posts' %>
          </div>
        <% end %>
        <% if @category.name == 'Q&A' %>
          <div class="pill-button">
            <%= link_to 'Random', query_url(sort: 'lottery'),
                        class: "#{params[:sort] == 'lottery' ? 'active' : ''}",
                        title: 'random set of questions, usually older ones' %>
          </div>
        <% end %>
      </div>
      <% current_cat = current_category %>
      <%= link_to category_post_types_path(current_cat.id),
                  class: 'category-header--nav-item mochi-button is-button' do %>
        <%= current_cat.button_text.present? ? current_cat.button_text : 'New Post' %>
      <% end %>
    </div>

    <div style="display: none;>
      <%= short_number_to_human post_count, precision: 1, significant: false %>
      <%= 'post'.pluralize(post_count) %> &middot;

      <% if current_user&.is_admin %>
        <%= link_to 'Edit Category', edit_category_path(@category) %>
        &middot;
      <% end %>

      <%= link_to 'Subscribe',
                  new_subscription_path(type: 'category', qualifier: @category.id, return_to: request.path),
                  class: 'button is-outlined' %>
    </div>

    <details style="display: none;">
      <summary>Filters (<%= @filtered ? @active_filter[:name] || 'Custom' : 'None' %>)</summary>
      <% if @active_filter[:default] == true %>
        <div class="notice is-info">
          You are currently filtering by <strong><%= @active_filter[:name] %></strong> because it is set as your default for this category
        </div>
      <% end %>
      <%= form_tag request.original_url, method: :get do %>
        <%= render 'search/filters' %>
      <% end %>
    </details>

    <div class="item-list">
      <% @posts.each do |post| %>
        <%= render 'mochi/posts/type_agnostic', post: post %>
      <% end %>
    </div>

    <div class="has-padding-top-4">
      <%= will_paginate @posts, renderer: BootstrapPagination::Rails %>
    </div>

    <div class="has-padding-top-4">
      <%= link_to category_feed_path(@category, format: 'rss'), class: 'category-rss-link' do %>
        <%= octicon 'rss', :height => 16, :"aria-label" => "Subscribe to RSS feed" %>
        Subscribe to RSS feed
      <% end %>
    </div>
  </div>
</div>


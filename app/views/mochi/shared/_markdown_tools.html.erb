<div class="modal is-with-backdrop" id="markdown-link-insert" style="display: none;">
  <div class="modal--container">
    <div class="modal--header">
      <button type="button" class="button is-close-button modal--header-button" data-modal="#markdown-link-insert">
        &times;
      </button>
      Link
    </div>
    <div class="modal--body">
      <div class="form-group">
        <label for="markdown-link-name" class="form-element">Link text</label>
        <input type="text" id="markdown-link-name" class="form-element" />
      </div>
      <div class="form-group">
        <label for="markdown-link-url" class="form-element">Link URL</label>
        <input type="text" id="markdown-link-url" class="form-element" />
      </div>

      <button type="submit" class="js-markdown-insert-link button is-filled">Insert</button>
    </div>
  </div>
</div>

<div class="markdown-tools widget--header js-markdown-tools">
  <%= md_button action: 'heading', label: 'Heading' do %>
    <%= octicon 'heading', :height => 16,  :class => "category-icon", :"aria-label" => "Heading" %>
  <% end %>
  <%= md_button action: 'bold', label: 'Bold', class: 'is-icon-only' do %>
    <%= octicon 'bold', :height => 16,  :class => "category-icon", :"aria-label" => "Bold" %>
  <% end %>
  <%= md_button action: 'italic', label: 'Italic', class: 'is-icon-only' do %>
    <%= octicon 'italic', :height => 16,  :class => "category-icon", :"aria-label" => "Italic" %>
  <% end %>
  <%= md_button action: 'quote', label: 'Block quote', class: 'is-icon-only' do %>
    <%= octicon 'quote', :height => 16,  :class => "category-icon", :"aria-label" => "Quote" %>
  <% end %>
  <%= md_button action: 'code', label: 'Monospace font', class: 'is-icon-only' do %>
    <%= octicon 'code', :height => 16,  :class => "category-icon", :"aria-label" => "Code" %>
  <% end %>
  <%= md_button label: 'Link', class: 'is-icon-only', data_modal: '#markdown-link-insert' do %>
    <%= octicon 'link', :height => 16,  :class => "category-icon", :"aria-label" => "Link" %>
  <% end %>
  <%= md_button action: 'numbered', label: 'Numbered list' do %>
    <%= octicon 'list-ordered', :height => 16,  :class => "category-icon", :"aria-label" => "Ordered list" %>
  <% end %>
  <%= md_button action: 'bullet', label: 'Bullet list' do %>
    <%= octicon 'list-unordered', :height => 16,  :class => "category-icon", :"aria-label" => "Unordered list" %>
  <% end %>
  <!--
  <%= md_button label: 'Insert image', class: 'is-icon-only', data_modal: '#markdown-image-upload' do %>
    <%= octicon 'paperclip', :height => 16,  :class => "category-icon", :"aria-label" => "Attach files" %>
  <% end %>
  -->

  <%= label_tag :file, octicon('paperclip', :height => 16, :"aria-label" => "Attach files"), form: 'upload-form', class: "form-element button" %>

  <% if SiteSetting['MathJaxEnabled'] %>
    <%= md_button action: 'mathjax', label: 'MathJax', class: 'is-icon-only' do %>
      $
    <% end %>
  <% end %>

  <!--
  <div class="button-list is-gutterless">
    <a href="javascript:void(0)" class="button is-muted is-outlined is-icon-only js-save-draft" aria-label="Save draft"
       title="Save draft" role="button">
      <i class="fas fa-save"></i>
    </a>
  </div>
  -->
</div>
